{
  "name": "chatshelf",
  "version": "0.4.0",
  "description": "One place for your AI coding chats: browse, search and bookmark Claude Code, Codex, Cursor and Copilot history, and fix Claude Code sessions after renaming a folder. Local, no dependencies.",
  "license": "MIT",
  "author": {
    "name": "Shaikh khoaiz Ahmmed",
    "url": "https://khoaiz.com"
  },
  "funding": {
    "type": "individual",
    "url": "https://khoaiz.com"
  },
  "homepage": "https://github.com/heyKhoaiz/chatshelf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heyKhoaiz/chatshelf.git"
  },
  "bugs": {
    "url": "https://github.com/heyKhoaiz/chatshelf/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "copilot",
    "chat-history",
    "ai",
    "developer-tools",
    "local-first"
  ],
  "type": "module",
  "bin": {
    "chatshelf": "bin/chatshelf.mjs"
  },
  "files": [
    "server.mjs",
    "core.mjs",
    "sources.mjs",
    "mcp.mjs",
    "public",
    "bin"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "node test/smoke.mjs",
    "check": "node --check server.mjs && node --check core.mjs && node --check sources.mjs && node --check mcp.mjs && node --check public/app.js && node --check vscode/extension.cjs",
    "prepublishOnly": "npm run check && npm test",
    "release": "node scripts/release.mjs",
    "test:vscode": "node test/vscode.mjs",
    "pack:vscode": "node scripts/pack-vscode.mjs"
  }
}
